{
  "name": "hive-admin",
  "private": true,
  "version": "0.4.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts && git diff --exit-code -- src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "lucide-react": "^1.59.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
