{
  "$comment": "Hive design tokens: the single source for colours, type, spacing, shape and motion. Run `python3 tools/gen_design.py` after editing; it writes app/lib/design/*.g.dart and admin/src/styles/tokens.css. Colour values are the contrast-checked set from Design review 2 (all text pairs pass WCAG AA).",
  "color": {
    "dark": {
      "bg": "#121110",
      "surface": "#1C1A18",
      "raised": "#26231F",
      "border": "#3A3530",
      "textPrimary": "#F5F1EB",
      "textSecondary": "#B5ACA1",
      "textTertiary": "#968C82",
      "accent": "#F2994A",
      "accentText": "#F2994A",
      "onAccent": "#1C1208",
      "lossless": "#7CC4B8",
      "success": "#6BCB8B",
      "warning": "#F2C14E",
      "danger": "#F07167",
      "onDanger": "#1C1208"
    },
    "light": {
      "bg": "#FAF8F5",
      "surface": "#FFFFFF",
      "raised": "#F2EEE8",
      "border": "#E2DCD3",
      "textPrimary": "#1C1A18",
      "textSecondary": "#6B635A",
      "textTertiary": "#6F675E",
      "accent": "#C8661A",
      "accentText": "#9C5C12",
      "onAccent": "#1C1208",
      "lossless": "#1B6E63",
      "success": "#187040",
      "warning": "#835B00",
      "danger": "#C2372D",
      "onDanger": "#FFFFFF"
    }
  },
  "font": {
    "family": "Inter",
    "fallbacks": ["NotoSansMalayalam", "NotoSansDevanagari"],
    "icons": "Lucide"
  },
  "type": {
    "display":  { "size": 34, "lineHeight": 40, "weight": 700, "letterSpacing": -0.022 },
    "title1":   { "size": 28, "lineHeight": 34, "weight": 700, "letterSpacing": -0.02 },
    "title2":   { "size": 22, "lineHeight": 28, "weight": 700, "letterSpacing": -0.016 },
    "headline": { "size": 17, "lineHeight": 22, "weight": 600, "letterSpacing": -0.01 },
    "body":     { "size": 15, "lineHeight": 20, "weight": 400 },
    "callout":  { "size": 14, "lineHeight": 19, "weight": 400 },
    "caption":  { "size": 12, "lineHeight": 16, "weight": 400 },
    "overline": { "size": 11, "lineHeight": 14, "weight": 600, "letterSpacing": 0.06, "uppercase": true }
  },
  "space": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "radius": { "badge": 4, "art": 10, "card": 12, "sheet": 20, "pill": 999 },
  "motion": { "fast": 150, "screen": 250, "sheet": 350 }
}
